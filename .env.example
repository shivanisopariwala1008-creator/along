# Copy to .env and fill in. .env is gitignored — never commit real values.
# Load before starting:  set -a; source .env; set +a; jac start --dev main.jac

# MongoDB connection string (Atlas: Connect -> Drivers). Unset = local SQLite.
MONGODB_URI=

# Signs login tokens. Generate with: openssl rand -hex 32
JWT_SECRET=

# Password for the built-in `admin` account (/admin portal).
ADMIN_PASSWORD=

# Optional: enables AI-written match explanations.
OPENAI_API_KEY=

# Google Maps (optional). Without a key the app draws its built-in map.
# Enable in Google Cloud: Maps JavaScript API, Routes API, Geocoding API.
GOOGLE_MAPS_API_KEY=
# Optional separate browser key (restrict it by HTTP referrer); defaults to the key above.
GOOGLE_MAPS_BROWSER_KEY=
# Optional Map ID for styled maps; defaults to Google's DEMO_MAP_ID.
GOOGLE_MAPS_MAP_ID=

# Optional: the "Tell Along where you're going" trip assistant (Google Gemini).
# Get a key at https://aistudio.google.com/apikey. Without it, a simpler
# rule-based reader handles common phrasings.
GEMINI_API_KEY=
# Optional model override (default: gemini-flash-lite-latest).
GEMINI_MODEL=

# Email for verification + password reset. Leave EMAILER_PROVIDER unset in
# development to print emails to the server log instead of sending them.
# Gmail: create an "app password" (Google Account -> Security -> App passwords).
EMAILER_PROVIDER=smtp
EMAILER_FROM=Along <your.address@gmail.com>
EMAILER_SMTP_HOST=smtp.gmail.com
EMAILER_SMTP_USERNAME=your.address@gmail.com
EMAILER_SMTP_PASSWORD=
# Public address of the app, used in email links (e.g. your Render URL).
APP_URL=http://localhost:8000
