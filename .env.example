# Copy to .env and fill in. .env is gitignored — never commit real values.
# Load before starting:  set -a; source .env; set +a; jac start --dev main.jac

# MongoDB connection string (Atlas: Connect -> Drivers). Unset = local SQLite.
MONGODB_URI=

# Signs login tokens. Generate with: openssl rand -hex 32
JWT_SECRET=

# Password for the built-in `admin` account (/admin portal).
ADMIN_PASSWORD=

# Optional: enables AI-written match explanations.
OPENAI_API_KEY=

# Google Maps (optional). Without a key the app draws its built-in map.
# Enable in Google Cloud: Maps JavaScript API, Routes API, Geocoding API.
GOOGLE_MAPS_API_KEY=
# Optional separate browser key (restrict it by HTTP referrer); defaults to the key above.
GOOGLE_MAPS_BROWSER_KEY=
# Optional Map ID for styled maps; defaults to Google's DEMO_MAP_ID.
GOOGLE_MAPS_MAP_ID=
